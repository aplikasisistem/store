{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/((?!sw\\.js|manifest\\.json|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/javascript" }
      ]
    }
  ]
}
